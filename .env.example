# Supabase project (Settings -> API). Use the service-role key: this runs server-side only.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ID=your-project-id
SUPABASE_SECRET=your-service-role-key

# Profile enrichment
PROXYCURL_SECRET=your-proxycurl-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
