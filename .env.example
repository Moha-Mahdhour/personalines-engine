# Supabase project (Settings -> API). Use the service-role key: this runs server-side only.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET=your-service-role-key

# Profile enrichment
PROXYCURL_SECRET=your-proxycurl-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Optional tuning (defaults shown)
# OPENAI_TEMPERATURE=1.0
# MAX_CONCURRENCY=8
# EXAMPLES_PER_PROMPT=7
# REQUEST_TIMEOUT=20
# MAX_RETRIES=5
# STORAGE_BUCKET=Users
# TASKS_TABLE=tasks
# WORK_DIR=Filing
# PORT=10000
